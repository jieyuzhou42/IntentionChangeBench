# Choose `deepseek`, `openai`, or `azure`.
LLM_PROVIDER=deepseek

# DeepSeek through its OpenAI-compatible Responses API
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Public OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=your-model-id
# OPENAI_BASE_URL=https://api.openai.com/v1

# Azure OpenAI
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_RESPONSES_ENDPOINT=https://your-resource-name.cognitiveservices.azure.com/openai/responses?api-version=2025-04-01-preview
AZURE_OPENAI_DEPLOYMENT=your-deployment-name
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# Legacy alternative if you want chat/completions instead of a full responses URL:
# AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com
# AZURE_OPENAI_CHAT_DEPLOYMENT=your-chat-deployment-name
